FROM ubuntu:18.04 as builder
RUN apt-get update && apt-get install -y wget ca-certificates
RUN mkdir /tme_extract && \
    wget https://github.com/TerraME/terrame/releases/download/2.0.1/terrame-2.0.1-ubuntu18.tar.gz && \
    tar -xf terrame-2.0.1-ubuntu18.tar.gz -C /tme_extract --strip-components=1

FROM ubuntu:18.04
COPY --from=builder /tme_extract /opt/terrame

# CAMADA 1: Dependências Base (Raramente mudam)
RUN apt-get update && apt-get install -y --no-install-recommends \
    libgl1-mesa-glx libglib2.0-0 libfontconfig1 libxrender1 libdbus-1-3 \
    libx11-xcb1 libxcb-xinerama0 libxcb-icccm4 libxcb-image0 \
    libxcb-keysyms1 libxcb-randr0 libxcb-render-util0 libxcb-xkb1 \
    libxkbcommon-x11-0 libice6 libsm6 libxt6

# CAMADA 2: Correções de Bibliotecas Faltantes (Adicionei libxi6 e libxcursor1)
# CAMADA 2: Correções de Bibliotecas + Configuração de Locale
RUN apt-get update && apt-get install -y --no-install-recommends \
    liblua5.3-0 libharfbuzz0b libfreetype6 libx11-6 libxext6 libxrender1 \
    libice6 libsm6 libxt6 libxi6 libxcursor1 libxrandr2 libxinerama1 \
    libxkbcommon-x11-0 libsqlite3-0 libxcb-xfixes0 libxcb-shape0 \
    libxcb-render-util0 libxcb-icccm4 libxcb-image0 libxcb-keysyms1 \
    libxcb-randr0 libxcomposite1 \
    locales \
    && echo "en_US.UTF-8 UTF-8" > /etc/locale.gen \
    && locale-gen \
    && apt-get clean && rm -rf /var/lib/apt/lists/*

# CONFIGURAÇÃO CRÍTICA DE AMBIENTE
ENV TME_PATH=/opt/terrame/bin
# Importante: LD_LIBRARY_PATH deve vir primeiro para o SWIG não se perder
ENV LD_LIBRARY_PATH=$TME_PATH
ENV PATH=$TME_PATH:$PATH

# Define onde os plugins do Qt estão (importante para evitar o erro do xcb)
ENV QT_QPA_PLATFORM_PLUGIN_PATH=$TME_PATH/platforms

# Configura o diretório de runtime para evitar o aviso do XDG_RUNTIME_DIR
ENV XDG_RUNTIME_DIR=/tmp/runtime-root

WORKDIR /opt/terrame/bin

# Rodamos através de um shell para garantir que as variáveis sejam lidas
ENTRYPOINT ["/bin/bash", "-c"]
CMD ["./terrame /opt/terrame/models/examples/hello_world.lua"]